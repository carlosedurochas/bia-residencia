<?xml version="1.0" ?>
<!--
  Spot parado para uma foto no Gazebo Harmonic.
  O modelo vem do Gazebo Fuel (OpenRobotics/bosdyn_spot, usado no desafio DARPA SubT) e é incluído como
  estático, para a física não derrubar o robô. A câmera "photo_camera" grava as imagens em disco.
-->
<sdf version="1.10">
  <world name="spot_photo">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.55 0.6 0.65 1</ambient>
            <diffuse>0.55 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <name>spot</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/bosdyn_spot</uri>
      <!-- A origem do modelo fica no corpo; com as pernas esticadas, os pés ficam 0,7 m abaixo dele -->
      <pose>0 0 0.70 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- Câmera em (1.6, -1.6, 0.9) olhando para (0, 0, 0.3): mesmo enquadramento das fotos dos outros simuladores.
         No SDF a câmera olha para +x; pitch positivo inclina para baixo. -->
    <model name="photographer">
      <static>true</static>
      <pose>1.6 -1.6 0.9 0 0.2592 2.3562</pose>
      <link name="link">
        <sensor name="photo_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <camera>
            <horizontal_fov>1.2695</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.01</near><far>100</far></clip>
            <save enabled="true"><path>/tmp/spot_gazebo_frames</path></save>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
